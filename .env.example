# Copy of what the app reads. Locally, `bundle exec rake setup` writes .env.development and
# .env.test for you with fresh random secrets. In production, set these as real environment variables.
RACK_ENV=development
DATABASE_URL=postgres:///job_tracker_development?user=job_tracker
# Only migrations use this one. It owns the password-hash table.
PASSWORD_DATABASE_URL=postgres:///job_tracker_development?user=job_tracker_password
SESSION_SECRET=   # 64+ random bytes: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
HMAC_SECRET=      # ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
# Encrypts everything users type (32 bytes as hex). Losing it loses the data: back it up off the server.
COLUMN_KEY=       # ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'

# Production only
APP_URL=https://your-app.example.com
MAIL_FROM=Job Tracker <no-reply@your-app.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
